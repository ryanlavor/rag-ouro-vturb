# Copie para backend/.env e preencha. Use UMA das duas opções de chave.

# Opção A: chave direta da Anthropic (console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-...
# MODELO_CLAUDE=claude-opus-5-5

# Opção B: OpenRouter (openrouter.ai, precisa ter créditos)
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=sk-or-v1-...
MODELO_CLAUDE=anthropic/claude-opus-5.5

GOOGLE_CLOUD_PROJECT=scraping-renda
COLECAO=RAG-OURO-VTURB
